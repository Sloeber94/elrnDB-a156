[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Place the car on the lifting bridge.</p><p><a href=\"#/3238224\">4450B10</a></p><p><a href=\"#/3238967\">7055B64</a></p><p><a href=\"#/3238966\">7055B54</a></p><p><a href=\"#/3237652\">1016A40</a></p><p><a href=\"#/3238399\">5510C14</a></p><p><a href=\"#/3237651\">1016A20</a></p><p><a href=\"#/3237644\">1092G10</a></p><p><a href=\"#/3237647\">1092G20</a></p><p><a href=\"#/3237642\">1092A12</a></p><p><a href=\"#/3237498\">1032D12</a></p><p><a href=\"#/3237715\">1092E10</a></p><p><a href=\"#/3237490\">1032B14</a></p><p><a href=\"#/3237720\">1092E24</a></p><p>Extract oil seal from its counter-rotating\nshaft front cover.</p>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Fit a new oil seal (1a) on counter-rotating shaft front cover\nby using tool (1b).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1a</p></td><td><p>Fitting tool</p></td><td colspan=\"1\"><p>1.821.251.000</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2013982.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p>End by carrying out the following operations:</p><p><a href=\"#/3237720\">1092E24</a></p><p><a href=\"#/3237490\">1032B14</a></p><p><a href=\"#/3237715\">1092E10</a></p><p><a href=\"#/3237498\">1032D12</a></p><p><a href=\"#/3237642\">1092A12</a></p><p><a href=\"#/3237647\">1092G20</a></p><p><a href=\"#/3237644\">1092G10</a></p><p><a href=\"#/3237651\">1016A20</a></p><p><a href=\"#/3238399\">5510C14</a></p><p><a href=\"#/3237652\">1016A40</a></p><p><a href=\"#/3238966\">7055B54</a></p><p><a href=\"#/3238967\">7055B64</a></p><p><a href=\"#/3238224\">4450B10</a></p><p>Take the car off the lifting bridge.</p>"],[264,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Position the vehicle on the ramp.</p><p>Ensure that the ignition key is in OFF\nposition, then disconnect the negative battery terminal.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>-</p></td><td><p>Battery</p></td><td colspan=\"1\"><p><a href=\"#/3235044\">A1B</a></p></td></tr></table></div><p>Proceed with removal \n                                          <a href=\"#/3238221\">4450B04</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3238966\">7055B54</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3237652\">1016A40</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3237715\">1092E10</a>\n                                           .</p><p>PROCEED AS FOLLOWS FOR THE LEFT COUNTER-BALANCE\nSHAFT COVER.</p><p>1. Undo the bolt (1a) for the left counter-balance shaft pulley\nusing the tool (1b) for counter-torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1b</p></td><td><p>Counter-torque</p></td><td colspan=\"1\"><p>1.820.286.000</p></td></tr></table></div><p>2. Remove the left counter-balance shaft pulley.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014474.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<p>1. Release and remove the left counter-balance shaft front oil seal.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000041.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Take care not to damage the oil\nseal seat during removal.</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014475.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<p>PROCEED AS FOLLOWS FOR THE RIGHT COUNTER-BALANCE\nSHAFT COVER.</p><p>1. Undo the bolt (1a) for the right counter-balance shaft pulley\nusing the tool (1b) for counter-torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1b</p></td><td><p>Counter-torque</p></td><td colspan=\"1\"><p>1.820.286.000</p></td></tr></table></div><p>2. Remove the right counter-balance shaft pulley.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014476.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<p>1. Release and remove the right counter-balance shaft front oil\nseal.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000041.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Take care not to damage the oil\nseal seat during removal.</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014477.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>PROCEED AS FOLLOWS FOR THE RIGHT COUNTER-BALANCE\nSHAFT COVER.</p><p>1. Fit a new right counter-balance shaft front oil seal (1a) in\nthe housing using the tool (1b).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1b</p></td><td><p>Fitting tool</p></td><td colspan=\"1\"><p>1.821.251.000</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014478.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<p>1. Place the right counter-balance shaft pulley in its housing.</p><p>2. Tighten the bolt (2a) for the right counter-balance shaft pulley\nto the recommended torque using the tool (2b) for counter-torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>2a</p></td><td><p>Bolt</p></td><td><p>COUNTER-ROTATING SHAFT PULLEY</p></td><td><p>M10</p></td><td colspan=\"1\"><p>(Counter balance shaft side) 4.5 ÷ 5.5</p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>2b</p></td><td><p>Counter-torque</p></td><td colspan=\"1\"><p>1.820.286.000</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014479.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<p>PROCEED AS FOLLOWS FOR THE LEFT COUNTER-BALANCE\nSHAFT COVER.</p><p>1. Fit a new oil seal (1a) in the housing on the left counter-balance\nshaft cover using the tool (1b).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1b</p></td><td><p>Fitting tool</p></td><td colspan=\"1\"><p>1.821.251.000</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014480.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<p>1. Fit a new oil seal (1a) in the housing on the left counter-balance\nshaft cover using the tool (1b).</p><p>2. Tighten the bolt (2a) for the left counter-balance shaft pulley\nto the recommended torque using the tool (2b) for counter-torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>2a</p></td><td><p>Bolt</p></td><td><p>COUNTER-ROTATING SHAFT PULLEY</p></td><td><p>M10</p></td><td colspan=\"1\"><p>(Counter balance shaft side) 4.5 ÷ 5.5</p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>2b</p></td><td><p>Counter-torque</p></td><td colspan=\"1\"><p>1.820.286.000</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014481.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<p>PROCEED AS DESCRIBED BELOW FOR BOTH COUNTER-BALANCE\nSHAFT COVERS.</p><p>Proceed with refitting \n                                          <a href=\"#/3237715\">1092E10</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3237652\">1016A40</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238966\">7055B54</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238221\">4450B04</a>\n                                           .</p><p>Connect the negative (-) battery terminal.</p><p>Remove the car from the ramps.</p>"]]
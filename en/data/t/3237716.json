[[2047,127,0,"<p><a href=\"#/3237717\">1092E16</a></p>"],[264,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Completely undo the nut (1a) loosened previously and remove the\ncounter-balance shaft drive belt tensioner (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2014800.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[264,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the counter-balance shaft belt tensioner\nback in its housing and secure it without tightening the nut.</p>"]]
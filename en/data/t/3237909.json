[[624,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the clutch release linkage.</p><p>2. Remove the outer non-slip bush.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2016916.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[624,127,0,"<p>1. Remove the inner non-slip bush (1a) using the tools (1b) and\n1c).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1b</p></td><td><p>Extractor</p></td><td colspan=\"1\"><p>1.821.253.000</p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1c</p></td><td><p>Counter weight</p></td><td colspan=\"1\"><p>1.840.206.001</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2016917.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[624,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit the inner non slip bush with a suitable\nfitting tool.</p><p>Fit the clutch release linkage.</p><p>Fit the outer non-slip bush.</p>"],[128,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the circlip (1a) and the lever (1b).</p><p>2. Remove the outer non-slip bush.</p><p>3. Remove the clutch release linkage.</p><p>4. Remove the inner non-slip bush.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2069636.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[128,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the inner non-slip bush back in its\nhousing.</p><p>Place the thrust bearing control linkage\nback in its housing.</p><p>Place the outer non-slip bush back in its\nhousing.</p><p>Place the lever back in its housing and\nsecure it using the circlip.</p>"]]
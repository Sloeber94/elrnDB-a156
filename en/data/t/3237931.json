[[270,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238022\">2710A31</a></p><p>Extract and remove oil seal from differential\nright flange.</p>"],[270,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Mount the new oil seal (1a) on differential right flange by means\nof tools (1b) and (1c).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>-</p></td><td><p>Fitting tool</p></td><td colspan=\"1\"><p>1.821.170.000</p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001268.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Country</p></th></tr><tr><td><p>1c</p></td><td><p>Grip</p></td><td colspan=\"1\"><p>1.821.171.000</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2017090.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[270,127,0,"<p><a href=\"#/3238022\">2710A31</a></p>"],[592,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238181\">4410A80</a></p><p><a href=\"#/3238224\">4450B10</a></p><p><a href=\"#/3238181\">4410A80</a></p><p><a href=\"#/3238181\">4410A80</a></p><p><a href=\"#/3238181\">4410A80</a></p><p><a href=\"#/3237966\">2110D54</a></p><p><a href=\"#/3237930\">2110D62</a></p>"],[592,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p><a href=\"#/3237930\">2110D62</a></p><p><a href=\"#/3238181\">4410A80</a></p><p><a href=\"#/3237705\">1076B50</a></p><p><a href=\"#/3238021\">2710A30</a></p><p><a href=\"#/3238181\">4410A80</a></p><p><a href=\"#/3238224\">4450B10</a></p><p><a href=\"#/3238181\">4410A80</a></p>"],[128,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Proceed with removal \n                                          <a href=\"#/3238181\">4410A80</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3238224\">4450B10</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3238967\">7055B64</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3238019\">2710A10</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3238021\">2710A30</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3238022\">2710A31</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3237966\">2110D54</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3237930\">2110D62</a>\n                                           .</p>"],[128,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Proceed with refitting \n                                          <a href=\"#/3237930\">2110D62</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3237966\">2110D54</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238022\">2710A31</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238021\">2710A30</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238019\">2710A10</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238967\">7055B64</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238224\">4450B10</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238181\">4410A80</a>\n                                           .</p>"],[1024,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Position the vehicle on the ramp</p><p>Proceed with removal \n                                          <a href=\"#/3238966\">7055B54</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3237866\">1076B70</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3237446\">1008A44</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/3238221\">4450B04</a>\n                                           .</p><p>Proceed with removal \n                                          <strong>- 7055B66 Engine compartment DUST\nSHIELD protection in right front wheel arch - R.R.</strong>\n                                           .</p><p>Proceed with removal \n                                          <strong>- 7055B91 Right front WHEEL ARCH\nLINER - R.R.</strong>\n                                           .</p><p>Proceed with the removal \n                                          <a href=\"#/3238181\">4410A80</a>\n                                           (Right side).</p><p>1. Remove the clip fastening the right front brake caliper to the\nbracket.</p><p>2. Undo the bolts (2a) and move the right front brake caliper (2b)\nsideways and secure it.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2069854.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1024,127,0,"<p>1. Loosen the band (1a) and disconnect the right driveshaft (1b)\nfrom the intermediate driveshaft.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2069855.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1024,127,0,"<p>1. Undo the bolts (1a) and remove the intermediate drive shaft (1b).</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Collect the manual gearbox oil\nthat comes out in a suitable container.</p></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2069856.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1024,127,0,"<p>Proceed with removal \n                                          <a href=\"#/3237930\">2110D62</a>\n                                           .</p>"],[1024,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Proceed with refitting \n                                          <a href=\"#/3237930\">2110D62</a>\n                                           .</p><p>Place the intermediate driveshaft in its\nhousing and secure it using the bolts.</p><p>Connect the right driveshaft to the intermediate\ndriveshaft and tighten the band.</p><p>1. Place the right front brake caliper (1a) back in its housing\nand tighten the bolts (1b) to the recommended torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>1b</p></td><td><p>-</p></td><td><p>-</p></td><td><p>-</p></td><td colspan=\"1\"><p>-</p></td></tr></table></div><p>2. Place the clip fastening the right front brake caliper to the\nbracket back in its housing.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2069857.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1024,127,0,"<p>Proceed with the refitting \n                                          <a href=\"#/3238181\">4410A80</a>\n                                           (Right side).</p><p>Proceed with refitting \n                                          <strong>- 7055B91 Right front WHEEL ARCH\nLINER - R.R.</strong>\n                                           .</p><p>Proceed with refitting \n                                          <strong>- 7055B66 Engine compartment DUST\nSHIELD protection in right front wheel arch - R.R.</strong>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238221\">4450B04</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3237446\">1008A44</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3237866\">1076B70</a>\n                                           .</p><p>Refill the manual gearbox and differential\nwith fluid \n                                          <strong>- 0010T41 MANUAL GEARBOX OIL - Check level and top up, if necessary</strong>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/3238966\">7055B54</a>\n                                           .</p><p>Remove the car from the ramps.</p>"]]
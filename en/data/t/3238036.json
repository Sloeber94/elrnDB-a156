[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the front brake caliper brackets\n(1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2017770.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p>1. Unscrew the bolt (1a) and remove the front brake discs (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2017771.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit the front brake discs and\ntighten the bolts to the specified torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>-</p></td><td><p>Pin</p></td><td><p>FRONT BRAKE DISC.</p></td><td><p>M8</p></td><td colspan=\"1\"><p>0.8 - 1.3</p></td></tr></table></div><p>Fit the front brake caliper bracket and\ntighten the bolts to the specified torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>-</p></td><td><p>Bolt</p></td><td><p>FRONT BRAKE CALIPER BRACKET</p></td><td><p>M14</p></td><td colspan=\"1\"><p>13.6 - 16.8</p></td></tr></table></div>"],[32,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Unscrew the pin  (1a) and remove the front brake disc (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2069896.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[32,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Refit the front brake disc (1a) in its seating and tighten its\nbolt (1b) to the specified torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>1b</p></td><td><p>Pin</p></td><td><p>FRONT BRAKE DISC.</p></td><td><p>M8</p></td><td colspan=\"1\"><p>(Wheel hub side) 1.0 ÷ 1.4</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2069897.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]
[[2047,127,0,"<aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000041.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>For precise identification of\nthe electrical connections, see Wiring Diagrams Section.</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside>"],[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238830\">7040G24</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3238803\">7040A65</a>\n                                           (right\nand left).</p><p><a href=\"#/3238117\">3380A44</a></p><p><a href=\"#/3238851\">7040L28</a></p><p><a href=\"#/3238849\">7040L20</a></p>"],[594,127,0,"<p><a href=\"#/3237544\">1056B82</a></p>"],[598,127,0,"<p>1. Disconnect the facia wiring harness clips.</p><p>2. Disconnect the electrical connections.</p><p>3. Disconnect the retaining bands.</p><p>4. Remove the heater case wiring harness.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018370.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the wiring is undamaged\nand that the individual conductors are firmly attached to the connections.</p><p>Check that the connections are fitted with\nanti-slip devices (secondary lock).</p><p>If necessary, check the continuity.</p><p>Refit the air conditioner case wiring harness.</p><p>Connect the retaining clips.</p><p>Connect the electrical connections.</p><p>Connect the clips to the facia wiring harness.</p>"],[594,127,0,"<p><a href=\"#/3237544\">1056B82</a></p>"],[598,127,0,"<p><a href=\"#/3238849\">7040L20</a></p><p><a href=\"#/3238851\">7040L28</a></p><p><a href=\"#/3238117\">3380A44</a></p><p><a href=\"#/3238803\">7040A65</a></p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238830\">7040G24</a></p>"],[2047,127,0,"<aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000041.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>For precise identification of\nthe electrical connections, see Wiring Diagrams Section.</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside>"],[2047,127,4104,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Working under the dashboard, undo the bolts.</p><p>2. Release retainer (2a) and remove fan soundproofing panel (2b)</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018420.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,4104,"<p><a href=\"#/3238830\">7040G24</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3238803\">7040A65</a>\n                                           (right\nand left)</p><p><a href=\"#/3238117\">3380A44</a></p><p><a href=\"#/3238851\">7040L28</a></p><p><a href=\"#/3238849\">7040L20</a></p>"],[16,127,4104,"<p><a href=\"#/3237544\">1056B82</a></p>"],[20,127,4104,"<p>1. Disconnect the facia wiring harness clips.</p><p>2. Disconnect the electrical connections.</p><p>3. Disconnect the retaining bands.</p><p>4. Remove the heater case wiring harness.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018421.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,4104,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the wiring is undamaged and\nthat the individual conductors are firmly attached to the connections.</p><p>Check that the connections are fitted with\nanti-slip devices (secondary lock).</p><p>If necessary, check the continuity.</p><p>Refit the air conditioner case wiring harness.</p><p>Connect the retaining clips.</p><p>Connect the electrical connections.</p><p>Connect the clips to the facia wiring harness.</p>"],[16,127,4104,"<p><a href=\"#/3237544\">1056B82</a></p>"],[20,127,4104,"<p><a href=\"#/3238849\">7040L20</a></p><p><a href=\"#/3238851\">7040L28</a></p><p><a href=\"#/3238117\">3380A44</a></p><p><a href=\"#/3238803\">7040A65</a>\n                                           (Left\nand right).</p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238830\">7040G24</a></p><p>Fit the fan soundproofing panel and secure\nit using the bolts.</p>"]]
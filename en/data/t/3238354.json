[[2047,127,16,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Carry out the following preliminary operations.</p><p><a href=\"#/3238830\">7040G24</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3238342\">5040D18</a></p>"],[594,127,16,"<p><a href=\"#/3237544\">1056B82</a></p>"],[598,127,16,"<p>1. Disconnect the facia wiring harness retaining clips.</p><p>2. Disconnect the electrical connection.</p><p>3. Turn and remove sensors (3a), then disconnect electrical connections\n(3b).</p><p>4. Disconnect the retaining bands.</p><p>5. Remove the air conditioner case wiring harness.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018561.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,16,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the wiring is undamaged and\nthat the individual conductors are firmly attached to the connections.</p><p>Check that the connections are fitted with\nthe anti-slip devices (secondary lock).</p><p>If necessary, check the continuity.</p><p>Refit the air conditioning case wiring\nharness.</p><p>Do up the retaining clips.</p><p>Connect the sensor electrical connections,\nthen fit into their seats and turn.</p><p>Connect the electrical connection.</p><p>Do up the facia wiring harness connecting\nclips.</p>"],[594,127,16,"<p><a href=\"#/3237544\">1056B82</a></p>"],[598,127,16,"<p><a href=\"#/3238342\">5040D18</a></p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238830\">7040G24</a></p>"],[2047,96,16,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238830\">7040G24</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238803\">7040A65</a>\n                                           (left\nand right sides)</p><p><a href=\"#/3238852\">7040L37</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238849\">7040L20</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3238342\">5040D18</a></p><p><a href=\"#/3238792\">7040A25</a></p><p><a href=\"#/3238501\">5560C51</a></p><p><a href=\"#/3238256\">5010C24</a></p><p><a href=\"#/3238254\">5010C12</a></p><p><a href=\"#/3238799\">7040A37</a></p><p><a href=\"#/3238800\">7040A44</a></p><p><a href=\"#/3238801\">7040A45</a></p><p><a href=\"#/3238788\">7040A09</a></p><aside class=\"note\"><img class=\"icon\" src=\"../media/768.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000166.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Before working on the Air Bag\nsystem follow the safety instructions for working on the system carefully.\n(\n                                                               <a href=\"#/3238524\">5580C</a>\n                                                                )</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside><p><a href=\"#/3238528\">5580C22</a></p><p><a href=\"#/3238460\">5540C18</a></p><p><a href=\"#/3238502\">5560C60</a></p><p><a href=\"#/3238496\">5560B02</a></p><p><a href=\"#/3238497\">5560B03</a></p><p><a href=\"#/3238527\">5580C18</a></p><p><a href=\"#/3238121\">4110A11</a></p><p><a href=\"#/3238793\">7040A26</a></p><p><a href=\"#/3238476\">5550A12</a></p><p><a href=\"#/3238789\">7040A10</a></p><p><a href=\"#/3238331\">5040C12</a></p><p>1. Disconnect the electrical connections for the motors (1a, 1b,\n1c, 1d).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1a</p></td><td><p>Left air mixture flap actuator</p></td><td colspan=\"1\"><p><a href=\"#/3237142\">N78</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1b</p></td><td><p>Air distribution actuator</p></td><td colspan=\"1\"><p><a href=\"#/3237146\">N80</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1c</p></td><td><p>Right air mixture flap actuator</p></td><td colspan=\"1\"><p><a href=\"#/3237144\">N79</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1d</p></td><td><p>Air intake actuator</p></td><td colspan=\"1\"><p><a href=\"#/3237153\">N82</a></p></td></tr></table></div><p>2. Disconnect the electrical connections (2a, 2b, 2c, 2d).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2a</p></td><td><p>Upper treated air sensor</p></td><td colspan=\"1\"><p><a href=\"#/3236695\">K88A</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2b</p></td><td><p>Upper treated air sensor</p></td><td colspan=\"1\"><p><a href=\"#/3236696\">K88B</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2c</p></td><td><p>Lower treated air sensor</p></td><td colspan=\"1\"><p><a href=\"#/3236691\">K87A</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2d</p></td><td><p>Lower treated air sensor</p></td><td colspan=\"1\"><p><a href=\"#/3236692\">K87B</a></p></td></tr></table></div><p>3. Disconnect the electrical connections (3a, 3b, 3c).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>3a</p></td><td><p>Passenger compartment ventilation fan</p></td><td colspan=\"1\"><p><a href=\"#/3237158\">N85</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>3b</p></td><td><p>Fan speed&#x27; variator</p></td><td colspan=\"1\"><p><a href=\"#/3236952\">M72A</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>3c</p></td><td><p>Fan speed&#x27; variator</p></td><td colspan=\"1\"><p><a href=\"#/3236955\">M72B</a></p></td></tr></table></div><p>4. Disconnect the wiring harness retaining collars.</p><p>5. Remove the wiring harness assembly.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018562.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,96,16,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Position the cable loom.</p><p>Connect the electrical connection.</p><p>Secure the wiring harness using retaining\nclips.</p><p><a href=\"#/3238331\">5040C12</a></p><p><a href=\"#/3238789\">7040A10</a></p><p><a href=\"#/3238476\">5550A12</a></p><p><a href=\"#/3238793\">7040A26</a></p><p><a href=\"#/3238121\">4110A11</a></p><p><a href=\"#/3238527\">5580C18</a></p><p><a href=\"#/3238497\">5560B03</a></p><p><a href=\"#/3238496\">5560B02</a></p><p><a href=\"#/3238502\">5560C60</a></p><p><a href=\"#/3238460\">5540C18</a></p><p><a href=\"#/3238528\">5580C22</a></p><p><a href=\"#/3238788\">7040A09</a></p><p><a href=\"#/3238801\">7040A45</a></p><p><a href=\"#/3238800\">7040A44</a></p><p><a href=\"#/3238799\">7040A37</a></p><p><a href=\"#/3238254\">5010C12</a></p><p><a href=\"#/3238256\">5010C24</a></p><p><a href=\"#/3238501\">5560C51</a></p><p><a href=\"#/3238792\">7040A25</a></p><p><a href=\"#/3238342\">5040D18</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3238849\">7040L20</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238852\">7040L37</a></p><p><a href=\"#/3238803\">7040A65</a>\n                                           (left\nand right sides)</p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238830\">7040G24</a></p>"],[2047,127,0,"<aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000041.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>For precise identification of\nthe electrical connections, see Wiring Diagrams Section.</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside>"],[2047,127,24,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Working under the dashboard, undo the bolts.</p><p>Disengage the retainers (2a) and remove\nthe fan sound-proofing panel (2b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018590.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,24,"<p><a href=\"#/3238830\">7040G24</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3238342\">5040D18</a></p>"],[16,127,24,"<p><a href=\"#/3237544\">1056B82</a></p>"],[20,127,24,"<p>1. Disconnect the facia wiring harness clips.</p><p>2. Disconnect the electrical connections:</p><p>3. Turn and remove sensors (3a), then disconnect electrical connections\n(3b).</p><p>4. Disconnect the retaining bands.</p><p>5. Remove the air conditioner case wiring harness.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018591.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,24,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the wiring is undamaged and\nthat the individual conductors are firmly attached to the connections.</p><p>Check that the connections are fitted with\nanti-slip devices (secondary lock).</p><p>If necessary, check the continuity.</p><p>Refit the air conditioner case wiring harness.</p><p>Connect the retaining clips.</p><p>Connect the sensor electrical connections,\nthen fit into their seats and turn.</p><p>Connect the electrical connections.</p><p>Connect the clips to the facia wiring harness.</p>"],[16,127,24,"<p><a href=\"#/3237544\">1056B82</a></p>"],[20,127,24,"<p><a href=\"#/3238342\">5040D18</a></p><p><a href=\"#/3238802\">7040A60</a></p><p><a href=\"#/3237934\">2125C24</a></p><p><a href=\"#/3238514\">5570T80</a></p><p><a href=\"#/3238986\">7065C42</a></p><p><a href=\"#/3238343\">5040D22</a></p><p><a href=\"#/3238790\">7040A14</a></p><p><a href=\"#/3238795\">7040A31</a></p><p><a href=\"#/3238829\">7040G20</a></p><p><a href=\"#/3238830\">7040G24</a></p><p>Fit the fan soundproofing panel and secure\nit using the bolts.</p>"]]
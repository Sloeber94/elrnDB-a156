[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238694\">7010N20</a></p><p>1. Disconnect power window motor electric connection.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Rear left electric window motor</p></td><td colspan=\"1\"><p><a href=\"#/3237058\">N65</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Rear right electric window motor</p></td><td colspan=\"1\"><p><a href=\"#/3237060\">N66</a></p></td></tr></table></div><p>2. Disconnect door cable electric connection.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Rear / rear door coupling left</p></td><td colspan=\"1\"><p><a href=\"#/3235778\">D35</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Rear right door connection</p></td><td colspan=\"1\"><p><a href=\"#/3235787\">D36</a></p></td></tr></table></div><p>3. Disconnect loom stop springs from door frame.</p><p>4. Extract loom from the inside of door.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018620.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check wiring is not  damaged\nand each single conductor is properly anchored to connections.</p><p>Check connections have secondary  lock\ndevices.</p><p>If necessary carry out proper continuity\ntests.</p><p>Insert wiring  inside door compartment.</p><p>Hook wiring  stop springs to door frame.</p><p>Connect electric connections.</p><p><a href=\"#/3238694\">7010N20</a></p>"]]
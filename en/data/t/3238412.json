[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Unloose fixing screws and remove\nsteering column guide.</p><p>1. Detach down-lead cable.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018668.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p>1. Disconnect electric connections (1a-1b) from ignition switch.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1a</p></td><td><p>Ignition switch</p></td><td colspan=\"1\"><p><a href=\"#/3236072\">H1A</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1b</p></td><td><p>Ignition switch</p></td><td colspan=\"1\"><p><a href=\"#/3236092\">H1B</a></p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018669.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p>1. Act on fixing tongues and take ignition switch contact carrier\nbolck off its seat.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018670.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p>1. Withdraw switch contact carrier block from ignition switch.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018671.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Mount switch contact carrier\nto ignition switch.</p><p>Mount down-lead cable.</p><p>Connect ignition switch electric connections.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>-</p></td><td><p>Ignition switch</p></td><td colspan=\"1\"><p><a href=\"#/3236072\">H1A</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>-</p></td><td><p>Ignition switch</p></td><td colspan=\"1\"><p><a href=\"#/3236092\">H1B</a></p></td></tr></table></div><p>Mount steering column  gaurd.</p>"]]
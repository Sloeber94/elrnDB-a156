[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Open the bonnet lid.</p>"],[128,127,0,"<p><a href=\"#/3238721\">7025A12</a></p><p><a href=\"#/3238722\">7025A14</a></p>"],[128,127,0,"<p>1. Rotate the cover in an anti-clockwise direction and extract it.</p><p>2. Disconnect the electrical connection.</p><p>3. Release the bulb retaining clip.</p><p>4. Extract the bulb.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/768.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000166.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>If the lamp is working properly,\ndo not touch the bulb with your hands; if this does happen, clean the\nbulb with alcohol.</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018808.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check the condition and the\ncleanliness of the lamp.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/768.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000166.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Do not touch the bulb with your\nhands; if this does happen, clean the bulb with alcohol.</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside><p>1. Fit the bulb in position as illustrated in the diagram.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018809.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p>Attach the bulb retaining clip.</p><p>Connect the electrical connection.</p><p>Position the cover and rotate it in place.</p><p>Check that the main beam headlamps are\nworking properly.</p>"],[128,127,0,"<p><a href=\"#/3238722\">7025A14</a></p><p><a href=\"#/3238721\">7025A12</a></p>"]]
[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Unscrew the clamping screws of the collar badge.</p><p>2. Take the collar badge off.</p><p>3. Unscrew the clamping screws of the fog lamp.</p><p>4. Extract the fog lamp (4a) and disconnect the electrical connection\n(4).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>4b</p></td><td><p>Left fog lamp</p></td><td colspan=\"1\"><p><a href=\"#/3235998\">F15</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>4b</p></td><td><p>Right fog lamp</p></td><td colspan=\"1\"><p><a href=\"#/3236000\">F16</a></p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018822.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Connect the electrical connection.</p><p>Test the functionality of the fog lamp.</p><p>Place the fog lamp in its seat.</p><p>Screw the clamping screws.</p><p>Place the collar badge.</p><p>Screw the clamping screw of the collar\nbadge.</p><p>If necessary,\n                                          <a href=\"#/3238470\">5540D38</a></p>"]]
[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238577\">7005C44</a></p><p><a href=\"#/3238607\">7005E38</a></p><p><a href=\"#/3238604\">7005E12</a></p><p><a href=\"#/3238605\">7005E22</a></p><p><a href=\"#/3238517\">5570T90</a></p><p><a href=\"#/3238603\">7005E11</a></p><p><a href=\"#/3238558\">7005A04</a></p><p><a href=\"#/3238599\">7005D30</a></p><p><a href=\"#/3238596\">7005D24</a></p><p><a href=\"#/3238589\">7005D15</a></p><p><a href=\"#/3238625\">7005R30</a></p><p><a href=\"#/3238598\">7005D26</a></p><p><a href=\"#/3238591\">7005D18</a></p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018981.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Use a new lining.</p><p>Thoroughly clean any adhesive residues\nfrom the fitting area using heptane.</p><p>Bathe the fitting area in soapy water.</p><p>1. Remove the protection from the adhesive side of the lining, then\nplace it in position.</p><p>The soapy water facilitates the sliding needed for the correct\npositioning.</p><p>2. Using a sponge, press on the lining to remove any air bubbles.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2018982.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p><a href=\"#/3238591\">7005D18</a></p><p><a href=\"#/3238598\">7005D26</a></p><p><a href=\"#/3238625\">7005R30</a></p><p><a href=\"#/3238589\">7005D15</a></p><p><a href=\"#/3238596\">7005D24</a></p><p><a href=\"#/3238599\">7005D30</a></p><p>Check that the window works properly.</p><p><a href=\"#/3238558\">7005A04</a></p><p><a href=\"#/3238603\">7005E11</a></p><p><a href=\"#/3238517\">5570T90</a></p><p><a href=\"#/3238605\">7005E22</a></p><p><a href=\"#/3238604\">7005E12</a></p><p><a href=\"#/3238607\">7005E38</a></p><p><a href=\"#/3238577\">7005C44</a></p>"]]
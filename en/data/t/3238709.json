[[2047,127,65536,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the seal (1a) from its housing, starting from the area\nof the join (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019063.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,65536,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the seal is intact and undamaged.</p><p>Fit the seal in its seat. The join should\nbe at the centre of the bottom side.</p>"]]
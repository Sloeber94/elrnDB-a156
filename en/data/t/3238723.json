[[128,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238721\">7025A12</a></p><p><a href=\"#/3238722\">7025A14</a></p>"],[128,127,0,"<p><a href=\"#/3238722\">7025A14</a></p><p><a href=\"#/3238964\">7055B42</a></p><p>1. Undo the hinge retaining nuts</p><p>2. Remove the hinge.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019074.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the hinge is undamaged.</p><p>1. Refit the hinge.</p><p>2. Fit the fixing nuts and tighten them to the recommended torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>2a</p></td><td><p>Lower nut</p></td><td><p>BONNET LID HINGES</p></td><td><p>-</p></td><td colspan=\"1\"><p>2.2 - 2.6</p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>2b</p></td><td><p>Upper nut</p></td><td><p>BONNET LID HINGES</p></td><td><p>-</p></td><td colspan=\"1\"><p>0.7 - 0.8</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019075.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<p><a href=\"#/3238722\">7025A14</a></p><p>Carry out op. \n                                          <a href=\"#/3238720\">7025A10</a></p><p><a href=\"#/3238964\">7055B42</a></p><p>Restore the protection on the lower part\nof the wing.</p>"],[128,127,0,"<p><a href=\"#/3238722\">7025A14</a></p><p><a href=\"#/3238721\">7025A12</a></p>"]]
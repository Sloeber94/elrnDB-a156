[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Open the boot lid and undo the bolt.</p><p>2. Recover the seal for the luggage retaining belt.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019269.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the seal is undamaged.</p><p>Position the seal and fix it using the\nbolt.</p>"],[2047,127,65536,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the luggage retaining belt seal fixing bolt.</p><p>2. Remove the luggage retaining belt seal.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019270.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,65536,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the luggage retaining belt seal\nis not damaged.</p><p>Position the luggage retaining belt seal.</p><p>Tighten the bolt.</p>"]]
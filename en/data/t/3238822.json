[[128,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238721\">7025A12</a></p><p><a href=\"#/3238722\">7025A14</a></p>"],[128,127,0,"<p>1. Open the bonnet and undo the bolts.</p><p>1. Release the retainers (2a) and remove the cover (2b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019271.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check the condition of the\ncover and the retainers.</p><p>Position the cover and engage the retainers.</p><p>Tighten the bolts.</p>"],[128,127,0,"<p><a href=\"#/3238722\">7025A14</a></p><p><a href=\"#/3238721\">7025A12</a></p>"]]
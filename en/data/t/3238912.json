[[2047,127,65536,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3238814\">7040B28</a></p><p><a href=\"#/3238808\">7040B10</a></p><p>Lift the rear cushion.</p><p>1. Undo the bolt securing the squab to the floor.</p><p>2. Undo the nut connecting the squabs.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019412.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,65536,"<p>Lower the squab.</p><p>1. Undo the bolts securing the squab to the floor.</p><p>2. Undo the nut connecting the squabs.</p><p>3. Remove the squab.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019413.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,65536,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the squab is not damaged.</p><p>1. Position the squab.</p><p>2. Tighten the nut connecting the squabs.</p><p>3. Tighten the bolts securing the squab to the floor.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>3</p></td><td><p>Bolt</p></td><td><p>REAR SEAT SQUAB</p></td><td><p>M8</p></td><td colspan=\"1\"><p>2.4</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019414.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,65536,"<p>1. Lift the squab.</p><p>2. Tighten the nut connecting the squabs.</p><p>3. Tighten the bolt securing the squab to the floor.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>3</p></td><td><p>Bolt</p></td><td><p>REAR SEAT SQUAB</p></td><td><p>M8</p></td><td colspan=\"1\"><p>2.4</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019415.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,65536,"<p>Check that the engagement device is working\nproperly.</p><p>If necessary, adjust the striker (refer\nto op. \n                                          <a href=\"#/3238927\">7050A45</a>\n                                           ).</p><p>Lower the rear cushion.</p><p><a href=\"#/3238808\">7040B10</a></p><p><a href=\"#/3238814\">7040B28</a></p>"]]
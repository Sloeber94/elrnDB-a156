[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the cover (1a) by using a screwdriver with thin blade\nand insert it in the proper crack (1b).</p><p>2. Remove the check rod from the hole and take the cover.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2000041.svg\" alt=\"\" loading=\"lazy\"></figure></th><th colspan=\"1\"><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Be careful not to damage the painting\nof the bumper .</p></aside></th></tr><tr><td></td><td colspan=\"1\"></td></tr></table></div></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019495.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Make sure that the cover is\nnot damaged.</p><p>Insert the rod  in the hole.</p><p>Place the cover into its seat.</p>"]]
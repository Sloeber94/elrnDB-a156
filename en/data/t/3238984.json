[[2047,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Lower handle and remove badge.</p><p>2. Unscrew screws.</p><p>3. Remove handle (3a) by removing it from stops (3b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2019529.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2047,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check handle is not damaged.</p><p>Reassembly handle by inserting it in stops.</p><p>Tighten screws.</p><p>Put badges on.</p>"]]
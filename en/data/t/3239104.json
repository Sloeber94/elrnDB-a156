[[128,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Tighten bolts (1a) and remove the thermostat (1b), complete with\nengine coolant temperature sensor (1c).</p><p>Remove the gasket.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2016883.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[128,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the thermostat, complete with gasket\nand coolant temperature sensor, back in its housing and tighten\nthe bolts to the recommended torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>-</p></td><td><p>-</p></td><td><p>-</p></td><td><p>-</p></td><td colspan=\"1\"><p>-</p></td></tr></table></div>"],[1024,127,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Tighten bolts (1a) and remove the thermostat (1b), complete with\nengine coolant temperature sensor (1c).</p><p>Remove the gasket.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2070326.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1024,127,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the thermostat, complete with gasket\nand coolant temperature sensor back in its housing.</p><p>Tighten the bolts to the specified torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>-</p></td><td><p>Bolt</p></td><td><p>THERMOSTAT</p></td><td><p>M8</p></td><td colspan=\"1\"><p>2.5</p></td></tr></table></div>"]]
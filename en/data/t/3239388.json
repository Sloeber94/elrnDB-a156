[[2047,127,0,"<h3>Functional description</h3><p>The connection for the TELEPASS device \n                              \n                              \n                              \n                              \n                              \n                              <strong>D76</strong>\n                              \n                              \n                              \n                              \n                              \n                               consists of\na supply controlled by the ignition (INT) (pin 1) coming from the\nline for fuse \n                              \n                              \n                              \n                              \n                              \n                              <strong>F1</strong>\n                              \n                              \n                              \n                              \n                              \n                               of the junction unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>B1</strong>\n                              \n                              \n                              \n                              \n                              \n                               and a connection\n(pin 3) to earth \n                              \n                              \n                              \n                              \n                              \n                              <strong>C30</strong>\n                              \n                              \n                              \n                              \n                              \n                              .</p>"]]
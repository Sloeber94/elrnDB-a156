[[2047,2,524288,"<h3>Functional description</h3><p>The supply for the centre module \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                               arrives\ndirectly from the battery. (maxifuse \n                              \n                              \n                              \n                              \n                              \n                              <strong>J/B1</strong>\n                              \n                              \n                              \n                              \n                              \n                              of \n                              \n                              \n                              \n                              \n                              \n                              <strong>B5</strong>\n                              \n                              \n                              \n                              \n                              \n                              ) to\npin 2 via fuse \n                              \n                              \n                              \n                              \n                              \n                              <strong>F10</strong>\n                              \n                              \n                              \n                              \n                              \n                               of the junction unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>B1</strong>\n                              \n                              \n                              \n                              \n                              \n                              . the supply controlled\nby the ignition (INT) reaches pin 1 from the line protected by fuse\n                              \n                              \n                              \n                              \n                              \n                              <strong>B11</strong>\n                              \n                              \n                              \n                              \n                              \n                              .\n Pin 3 is earthed.</p>"],[6,2,524288,"<h3>Functional description</h3><p>The standard engine temperature sender unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>K36</strong>\n                              \n                              \n                              \n                              \n                              \n                               sends\na signal proportional to the temperature of the engine coolant (pin\n1) to pin 10 of \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                              . The minimum temperature signal, on the\nother hand, arrives at pin 9 of \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                               from the engine control\nunit \n                              \n                              \n                              \n                              \n                              \n                              <strong>M10</strong>\n                              \n                              \n                              \n                              \n                              \n                              .</p>"],[16,2,524288,"<h3>Functional description</h3><p>Sender unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>K35</strong>\n                              \n                              \n                              \n                              \n                              \n                               sends two independent\nsignals: the first is proportional to the temperature of the engine\ncoolant: it reaches pin 10 of module \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                               and acts on the\ngauge; the second signal, connected to the maximum temperature thermal\ncontact, reaches pin 9 and causes the relevant warning light to\ncome on.</p>"],[576,2,524288,"<h3>Functional description</h3><p>Sender unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>K35</strong>\n                              \n                              \n                              \n                              \n                              \n                               sends a signal proportional\nto the temperature of the engine coolant to pin 10 of module \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                              .\nThe overheating signal reaches pin 9 from the engine control unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>M10</strong>\n                              \n                              \n                              \n                              \n                              \n                              .</p>"],[2047,2,524288,"<h3>Functional description</h3><p>Pins 4 and 5 of the centre instrument \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                               receive\nsignals (positive and negative) coming from the fuel gauge \n                              \n                              \n                              \n                              \n                              \n                              <strong>N40</strong>\n                              \n                              \n                              \n                              \n                              \n                               located\nin the fuel pump unit.</p>"]]
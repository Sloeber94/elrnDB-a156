[[2047,3,0,"<h3>Functional description</h3><p>The supply for the centre module \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                               arrives\ndirectly from the battery. (maxifuse \n                              \n                              \n                              \n                              \n                              \n                              <strong>J/B1</strong>\n                              \n                              \n                              \n                              \n                              \n                              of \n                              \n                              \n                              \n                              \n                              \n                              <strong>B5</strong>\n                              \n                              \n                              \n                              \n                              \n                              ) to\npin 2 via fuse \n                              \n                              \n                              \n                              \n                              \n                              <strong>F10</strong>\n                              \n                              \n                              \n                              \n                              \n                               of the junction unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>B1</strong>\n                              \n                              \n                              \n                              \n                              \n                              ; the supply controlled\nby the ignition (INT) reaches pin 1 of the line protected by fuse \n                              \n                              \n                              \n                              \n                              \n                              <strong>B11</strong>\n                              \n                              \n                              \n                              \n                              \n                              .\n Pin 3 is earthed.</p>"],[22,3,0,"<h3>Functional description</h3><p>The sender unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>K35</strong>\n                              \n                              \n                              \n                              \n                              \n                               sends two independent\nsignals: the first is proportional to the engine coolant temperature:\nit reaches pin 10 of module \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                               and acts on the gauge; the\nsecond signal, connected to the maximum temperature thermal contact,\nreaches pin 9 and causes the relevant warning light to come on.</p>"],[576,3,0,"<h3>Functional description</h3><p>Sender unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>K35</strong>\n                              \n                              \n                              \n                              \n                              \n                               sends a signal proportional\nto the temperature of the engine coolant to pin 10 of module \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                              .\nThe overheating signal reaches pin 9 from the engine control unit \n                              \n                              \n                              \n                              \n                              \n                              <strong>M10</strong>\n                              \n                              \n                              \n                              \n                              \n                              .</p>"],[2047,3,0,"<h3>Functional description</h3><p>Pins 4 and 5 of the centre instrument \n                              \n                              \n                              \n                              \n                              \n                              <strong>E20</strong>\n                              \n                              \n                              \n                              \n                              \n                               receive\nsignals (positive and negative) coming from the fuel gauge \n                              \n                              \n                              \n                              \n                              \n                              <strong>N40</strong>\n                              \n                              \n                              \n                              \n                              \n                              located\nin the fuel pump unit.</p>"]]